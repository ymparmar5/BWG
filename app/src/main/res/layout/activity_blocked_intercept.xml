<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layout_blocked_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:fitsSystemWindows="true"
    android:paddingStart="28dp"
    android:paddingEnd="28dp"
    android:paddingTop="36dp"
    android:paddingBottom="36dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:orientation="vertical"
        android:gravity="center">

        <TextView
            android:id="@+id/blocked_app_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="App"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="18sp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.05"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/blocked_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Distraction Blocked"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="28sp"
            android:fontFamily="sans-serif"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/blocked_detail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Detail info"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="16sp"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:layout_marginBottom="20dp" />

        <!-- Prominent Today's Usage Display -->
        <TextView
            android:id="@+id/blocked_usage_today"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Time spent today: --"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="17sp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/blocked_unlock_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Unlocks at 07:00"
            android:textColor="@color/gray_muted"
            android:textSize="14sp"
            android:fontFamily="sans-serif-light" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical">

        <Button
            android:id="@+id/btn_secondary_action"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Lock Screen"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium"
            android:textAllCaps="false"
            android:visibility="gone"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/btn_return_home"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Return Home"
            android:textSize="16sp"
            android:fontFamily="sans-serif-medium"
            android:textAllCaps="false" />
    </LinearLayout>

</RelativeLayout>
