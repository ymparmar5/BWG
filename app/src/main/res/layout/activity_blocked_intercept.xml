<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:fitsSystemWindows="true"
    android:padding="32dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:orientation="vertical"
        android:gravity="center">

        <TextView
            android:id="@+id/blocked_app_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="App"
            android:textColor="@color/white_translucent"
            android:textSize="20sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/blocked_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Limit Reached"
            android:textColor="@color/white"
            android:textSize="28sp"
            android:fontFamily="sans-serif"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/blocked_detail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Detail info"
            android:textColor="@color/white_translucent"
            android:textSize="16sp"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <TextView
            android:id="@+id/blocked_unlock_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Unlocks at 14:00"
            android:textColor="@color/gray_muted"
            android:textSize="14sp"
            android:fontFamily="sans-serif-light" />
    </LinearLayout>

    <Button
        android:id="@+id/btn_return_home"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_alignParentBottom="true"
        android:text="Return Home"
        android:textColor="@color/black"
        android:backgroundTint="@color/white"
        android:fontFamily="sans-serif-medium"
        android:textAllCaps="false" />

</RelativeLayout>

