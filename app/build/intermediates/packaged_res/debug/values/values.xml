<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:ns1="http://schemas.android.com/tools">
    <attr format="color" name="focusDividerColor"/>
    <attr format="color" name="focusSectionHeaderColor"/>
    <color name="black">#000000</color>
    <color name="gray_border">#2E2E2E</color>
    <color name="gray_dark">#1A1A1A</color>
    <color name="gray_muted">#777777</color>
    <color name="theme_bg_dark">#000000</color>
    <color name="theme_bg_light">#FFFFFF</color>
    <color name="theme_divider_dark">#1E1E1E</color>
    <color name="theme_divider_light">#E0E0E0</color>
    <color name="theme_subtext_dark">#B3FFFFFF</color>
    <color name="theme_subtext_light">#777777</color>
    <color name="theme_text_dark">#FFFFFF</color>
    <color name="theme_text_light">#111111</color>
    <color name="white">#FFFFFF</color>
    <color name="white_translucent">#B3FFFFFF</color>
    <string name="accessibility_service_description">Monitors and blocks addictive short-form content (YouTube Shorts, Instagram Reels, WhatsApp Status) and enforces app limits.</string>
    <string name="app_info">App info</string>
    <string name="app_name">Focus</string>
    <string name="app_options">App Options</string>
    <string name="block_notifications">Block notifications</string>
    <string name="hide_app">Hide app</string>
    <string name="pin_to_favorites">Add to favorites</string>
    <string name="remove_from_favorites">Remove from favorites</string>
    <string name="rename_app">Rename app</string>
    <string name="search_hint">Search apps</string>
    <string name="set_limits">Set usage limits</string>
    <string name="set_mindful_delay">Mindful launch delay</string>
    <string name="unblock_notifications">Allow notifications</string>
    <string name="unhide_app">Unhide app</string>
    <string name="uninstall">Uninstall</string>
    <style name="Theme.FocusLauncher" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/theme_bg_dark</item>
        <item name="android:colorBackground">@color/theme_bg_dark</item>
        <item name="android:statusBarColor">@color/theme_bg_dark</item>
        <item name="android:navigationBarColor">@color/theme_bg_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" ns1:targetApi="o_mr1">false</item>
        <item name="android:textColorPrimary">@color/theme_text_dark</item>
        <item name="android:textColorSecondary">@color/theme_subtext_dark</item>
        <item name="android:windowLayoutInDisplayCutoutMode" ns1:targetApi="p">shortEdges</item>
        <item name="colorAccent">@color/white</item>
        <item name="focusDividerColor">@color/theme_divider_dark</item>
        <item name="focusSectionHeaderColor">@color/gray_muted</item>
    </style>
    <style name="Theme.FocusLauncher.Light" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@color/theme_bg_light</item>
        <item name="android:colorBackground">@color/theme_bg_light</item>
        <item name="android:statusBarColor">@color/theme_bg_light</item>
        <item name="android:navigationBarColor">@color/theme_bg_light</item>
        <item name="android:windowLightStatusBar" ns1:targetApi="m">true</item>
        <item name="android:windowLightNavigationBar" ns1:targetApi="o_mr1">true</item>
        <item name="android:textColorPrimary">@color/theme_text_light</item>
        <item name="android:textColorSecondary">@color/theme_subtext_light</item>
        <item name="android:windowLayoutInDisplayCutoutMode" ns1:targetApi="p">shortEdges</item>
        <item name="colorAccent">@color/black</item>
        <item name="focusDividerColor">@color/theme_divider_light</item>
        <item name="focusSectionHeaderColor">@color/gray_muted</item>
    </style>
</resources>