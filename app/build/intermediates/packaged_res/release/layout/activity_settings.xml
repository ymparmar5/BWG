<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="36dp"
        android:paddingBottom="48dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Focus Settings"
            android:textColor="@color/white"
            android:textSize="26sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="24dp" />

        <!-- 1. PERMISSIONS DASHBOARD -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PERMISSIONS HEALTH DASHBOARD"
            android:textColor="@color/gray_muted"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.1"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:id="@+id/btn_perm_launcher"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:background="?android:attr/selectableItemBackground">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Default Launcher"
                android:textColor="@color/white"
                android:textSize="16sp" />
            <TextView
                android:id="@+id/status_perm_launcher"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Checking..."
                android:textColor="@color/gray_muted"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_perm_accessibility"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:background="?android:attr/selectableItemBackground">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Accessibility Service (Content Blocker)"
                android:textColor="@color/white"
                android:textSize="16sp" />
            <TextView
                android:id="@+id/status_perm_accessibility"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Checking..."
                android:textColor="@color/gray_muted"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_perm_usage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:background="?android:attr/selectableItemBackground">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Usage Access (App Usage Limits)"
                android:textColor="@color/white"
                android:textSize="16sp" />
            <TextView
                android:id="@+id/status_perm_usage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Checking..."
                android:textColor="@color/gray_muted"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_perm_notif"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:background="?android:attr/selectableItemBackground">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Notification Access (Filter)"
                android:textColor="@color/white"
                android:textSize="16sp" />
            <TextView
                android:id="@+id/status_perm_notif"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Checking..."
                android:textColor="@color/gray_muted"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_perm_dnd"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:background="?android:attr/selectableItemBackground">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Do Not Disturb Access (Night Automation)"
                android:textColor="@color/white"
                android:textSize="16sp" />
            <TextView
                android:id="@+id/status_perm_dnd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Checking..."
                android:textColor="@color/gray_muted"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_perm_battery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:background="?android:attr/selectableItemBackground">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ignore Battery Optimization (OEM Survival)"
                android:textColor="@color/white"
                android:textSize="16sp" />
            <TextView
                android:id="@+id/status_perm_battery"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Checking..."
                android:textColor="@color/gray_muted"
                android:textSize="13sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/gray_dark"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="20dp" />

        <!-- 2. HOME SCREEN & DRAWER -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HOME SCREEN &amp; DRAWER"
            android:textColor="@color/gray_muted"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.1"
            android:layout_marginBottom="12dp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switch_auto_launch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Auto-Launch Exact Search Match"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp" />

        <TextView
            android:id="@+id/btn_assign_swipe_left"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Swipe Left App: Default (Camera)"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:background="?android:attr/selectableItemBackground" />

        <TextView
            android:id="@+id/btn_assign_swipe_right"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Swipe Right App: Default (Phone)"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:background="?android:attr/selectableItemBackground" />

        <TextView
            android:id="@+id/btn_manage_favorites"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Manage Favorites (Max 7)"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:background="?android:attr/selectableItemBackground" />

        <TextView
            android:id="@+id/btn_manage_hidden"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Manage Hidden Apps"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:background="?android:attr/selectableItemBackground" />

        <TextView
            android:id="@+id/btn_manage_renamed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Manage Renamed App Aliases"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:background="?android:attr/selectableItemBackground" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/gray_dark"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="20dp" />

        <!-- 3. CONTENT BLOCKER & JSON RULES -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CONTENT BLOCKER (SHORTS / REELS / STATUS)"
            android:textColor="@color/gray_muted"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.1"
            android:layout_marginBottom="12dp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switch_blocker"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Enable Content Blocker"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switch_blocker_debug"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Live Debug Inspector Mode"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp" />

        <TextView
            android:id="@+id/btn_view_inspector_logs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Rule Inspector (View Last 30 Node IDs)"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:background="?android:attr/selectableItemBackground" />

        <TextView
            android:id="@+id/btn_edit_json_rules"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="JSON Rule Store Editor"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:background="?android:attr/selectableItemBackground" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/gray_dark"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="20dp" />

        <!-- 4. APP LIMITS & MINDFUL DELAY -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="USAGE LIMITS &amp; MINDFUL DELAYS"
            android:textColor="@color/gray_muted"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.1"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/btn_manage_limits"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Manage App Limits &amp; Schedules"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:background="?android:attr/selectableItemBackground" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/gray_dark"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="20dp" />

        <!-- 5. NOTIFICATION FILTER & SAFETY DIGEST -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NOTIFICATION FILTER"
            android:textColor="@color/gray_muted"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.1"
            android:layout_marginBottom="12dp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switch_notif_filter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Enable Notification Filter"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp" />

        <TextView
            android:id="@+id/btn_toggle_notif_mode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Filter Mode: Blocklist"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:background="?android:attr/selectableItemBackground" />

        <TextView
            android:id="@+id/btn_manage_notifs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Manage Blocked / Allowed Apps"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:background="?android:attr/selectableItemBackground" />

        <TextView
            android:id="@+id/btn_view_safety_digest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Safety Digest (Last 50 Dismissed)"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:background="?android:attr/selectableItemBackground" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/gray_dark"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="20dp" />

        <!-- 6. AUTOMATION -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AUTOMATION (NIGHT SILENT / DND)"
            android:textColor="@color/gray_muted"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.1"
            android:layout_marginBottom="12dp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switch_dnd"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Silent / DND Schedule"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp" />

        <LinearLayout
            android:id="@+id/btn_dnd_start_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:background="?android:attr/selectableItemBackground">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Start Time"
                android:textColor="@color/white"
                android:textSize="16sp" />
            <TextView
                android:id="@+id/text_dnd_start_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="22:00"
                android:textColor="@color/white_translucent"
                android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_dnd_end_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:background="?android:attr/selectableItemBackground">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="End Time"
                android:textColor="@color/white"
                android:textSize="16sp" />
            <TextView
                android:id="@+id/text_dnd_end_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="07:00"
                android:textColor="@color/white_translucent"
                android:textSize="16sp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
